        { "name": "List regular sales", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/regular", "host": ["{{baseUrl}}"], "path": ["sales", "regular"] } } },
        { "name": "List layaway sales", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/layaway", "host": ["{{baseUrl}}"], "path": ["sales", "layaway"] } } },
        { "name": "List overdue layaways", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/overdue", "host": ["{{baseUrl}}"], "path": ["sales", "overdue"] } } },
        { "name": "List consigned sales", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/consigned", "host": ["{{baseUrl}}"], "path": ["sales", "consigned"] } } },
        { "name": "List cancelled sales", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/cancelled", "host": ["{{baseUrl}}"], "path": ["sales", "cancelled"] } } },
        { "name": "List fully paid sales", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/sales/paid", "host": ["{{baseUrl}}"], "path": ["sales", "paid"] } } },
        {
          "name": "Client transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sales/client/{{clientId}}/transactions?pageNumber=1&displayPerPage=10&orderBy=desc",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "client", "{{clientId}}", "transactions"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "displayPerPage", "value": "10" },
                { "key": "orderBy", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get sale",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/sales/id/{{saleId}}", "host": ["{{baseUrl}}"], "path": ["sales", "id", "{{saleId}}"] }
          }
        },
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_ext_id\": \"{{clientId}}\",\n  \"type\": \"L\",\n  \"products\": [\n    { \"product_ext_id\": \"{{productId}}\", \"qty\": 1 }\n  ],\n  \"layaway\": {\n    \"no_of_months\": 3,\n    \"due_date\": \"2025-09-01\"\n  },\n  \"is_discounted\": false,\n  \"discount_percentage\": \"0\",\n  \"discount_flat_rate\": \"0\",\n  \"date_purchased\": \"2025-06-01\",\n  \"payment\": {\n    \"amount\": \"30000\",\n    \"payment_date\": \"2025-06-01\",\n    \"payment_method\": \"Cash\"\n  },\n  \"images\": [],\n  \"created_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales", "host": ["{{baseUrl}}"], "path": ["sales"] },
            "description": "type R = regular (fully paid), L = layaway (requires layaway plan; deposit must not exceed total)."
          }
        },
        {
          "name": "Record payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale_ext_id\": \"{{saleId}}\",\n  \"payment\": {\n    \"amount\": \"10000\",\n    \"payment_date\": \"2025-07-01\",\n    \"payment_method\": \"Cash\"\n  },\n  \"created_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales/payment", "host": ["{{baseUrl}}"], "path": ["sales", "payment"] },
            "description": "Layaway payments only; rejects fully paid/cancelled sales and overpayments."
          }
        },
        {
          "name": "Cancel sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale_ext_id\": \"{{saleId}}\",\n  \"cancelled_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales/cancel", "host": ["{{baseUrl}}"], "path": ["sales", "cancel"] },
            "description": "Cancels the sale and returns sold quantities to stock."
          }
        },
        {
          "name": "Extend layaway due date",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
