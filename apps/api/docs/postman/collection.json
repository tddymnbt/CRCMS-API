            },
            "url": { "raw": "{{baseUrl}}/sales/layaway/extend-due-date/{{saleId}}", "host": ["{{baseUrl}}"], "path": ["sales", "layaway", "extend-due-date", "{{saleId}}"] },
            "description": "New due date must be later than the current due date."
          }
        },
