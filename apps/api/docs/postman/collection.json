{
  "info": {
    "_postman_id": "b7e3c2a1-5f4d-4c8e-9a6b-lwphsimsapi01",
    "name": "LWPH SIMS API",
    "description": "Collection for the LWPH SIMS NestJS backend (apps/api). Set `baseUrl` to your environment (default http://localhost:3001). Obtain a token via Authentication > Login + Verify OTP; the collection sends `Authorization: Bearer {{token}}` on every request. Note: currently only Logout enforces authentication server-side.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "uX9kQ2mVzR" },
    { "key": "clientId", "value": "cCL0000001" },
    { "key": "productId", "value": "pPR0000001" },
    { "key": "saleId", "value": "sSA0000001" },
    { "key": "categoryId", "value": "pCA0000001" },
    { "key": "brandId", "value": "pBR0000001" },
    { "key": "authenticatorId", "value": "pAU0000001" },
    { "key": "consignorId", "value": "cCL0000001" }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Get status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/status", "host": ["{{baseUrl}}"], "path": ["status"] },
            "description": "Service health and version."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (request OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Sends an OTP to the email (if registered) and returns a one-time `status.token` needed by Login/Verify. Response is identical whether or not the email exists."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"token\": \"<one-time token from login>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/verify", "host": ["{{baseUrl}}"], "path": ["auth", "login", "verify"] },
            "description": "Returns `access.token` (JWT, 3600 s) on success. Copy it into the `token` collection variable. 404 when the OTP/token is invalid, expired or already used."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/resend", "host": ["{{baseUrl}}"], "path": ["auth", "login", "resend"] },
            "description": "Generates a new OTP and one-time token; the previous token becomes unusable."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": "bearer",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revokes the current bearer token. The only endpoint that requires authentication today; returns 401 when the token is missing/invalid/expired/revoked."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?searchValue=&isActive=Y&pageNumber=1&displayPerPage=10&sortBy=first_name&orderBy=asc",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "searchValue", "value": "" },
                { "key": "isActive", "value": "Y", "description": "Y or N (default Y)" },
                { "key": "pageNumber", "value": "1" },
                { "key": "displayPerPage", "value": "10" },
                { "key": "sortBy", "value": "first_name" },
                { "key": "orderBy", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"created_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "201 on success; 409 when the email already exists."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"updated_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] },
            "description": "Partial update: any subset of first_name, last_name, email, created_by, updated_by, deleted_by."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deleted_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Update user role",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleName\": \"Admin\",\n  \"updated_by\": \"admin_user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/update-role/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "update-role", "{{userId}}"] },
            "description": "Roles are seeded: Admin, Staff. 409 when the user already has the role."
          }
        }
      ]
    },
